# Mateixa BD que el CRM (pooler de Supabase en mode transacció).
# Pots enganxar la URL del CRM tal qual: el paràmetre ?pgbouncer=true s'ignora.
DATABASE_URL=

# SMTP de Microsoft 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitent visible
CORREU_REMITENT_EMAIL=
CORREU_REMITENT_NOM=UAUU weddings & events

# Mode prova: emails o dominis (@uauu.cat) separats per comes.
# Si no és buida, qualsevol altre destinatari queda CANCELAT. En producció, buida.
CORREU_LLISTA_BLANCA=

# bucle = procés continu | tick = només processa quan algú crida POST /api/tick
MODE_WORKER=bucle
TICK_SECRET=
TICK_MAX_SEGONS=25

# Accés al panell
PANELL_USUARI=
PANELL_CONTRASENYA=

PORT=3000

# Opcionals
# Nombre de proxies de confiança davant l'app (per defecte 1)
TRUST_PROXY=1
# Exigir HTTPS (per defecte sí, excepte a localhost)
EXIGEIX_HTTPS=
